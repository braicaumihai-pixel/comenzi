services:
  - type: web
    name: comenzi-paine
    runtime: python
    plan: starter
    rootDir: server-comenzi-paine-2
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn app:app --workers 1 --threads 4
    disk:
      name: date
      mountPath: /var/data
      sizeGB: 1
    envVars:
      - key: DB_PATH
        value: /var/data/orders.db
      - key: SMTP_HOST
        sync: false
      - key: SMTP_PORT
        value: "587"
      - key: SMTP_USER
        sync: false
      - key: SMTP_PASS
        sync: false
      - key: MAIL_TO
        value: mihai@moaramihalceni.ro
      - key: ADMIN_KEY
        generateValue: true
